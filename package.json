{
  "name": "yw-look",
  "private": true,
  "version": "0.3.2",
  "license": "MIT",
  "type": "module",
  "imports": {
    "#yw-look-mmd-loader-entry": "./src/packs/mmd-loader-pack/loaderInstalled.ts",
    "#yw-look-spark-loader-entry": "./src/packs/gaussian-splat-loader-pack/loaderInstalled.ts"
  },
  "scripts": {
    "dev": "node scripts/kill-port.mjs 1420 && vite",
    "build": "tsc && vite build",
    "build:core": "node scripts/run-loader-pack-profile.mjs core -- npm run build",
    "build:loaders": "node scripts/run-loader-pack-profile.mjs all -- npm run build",
    "check:loader-profile:core": "npm run build:core && node scripts/check-loader-pack-profile.mjs core",
    "check:loader-profile:loaders": "npm run build:loaders && node scripts/check-loader-pack-profile.mjs all",
    "check:loader-profiles": "npm run check:loader-profile:core && npm run check:loader-profile:loaders",
    "build:desktop": "npm run build && npm run tauri build",
    "bundle:win": "npm run prepare:nsis-loader-packs && npm run tauri build -- --features flip-compare --config src-tauri/tauri.windows.json --config src-tauri/tauri.windows.loaders.json --bundles nsis",
    "bundle:win:core": "node scripts/run-loader-pack-profile.mjs core -- npm run tauri build -- --features flip-compare --config src-tauri/tauri.windows.json --bundles nsis",
    "bundle:win:loaders": "npm run prepare:nsis-loader-packs && node scripts/run-loader-pack-profile.mjs all -- npm run tauri build -- --features flip-compare --config src-tauri/tauri.windows.json --config src-tauri/tauri.windows.loaders.json --bundles nsis",
    "bundle:mac": "npm run tauri build -- --features flip-compare --config src-tauri/tauri.macos.json --bundles app,dmg",
    "generate:license-attributions": "node scripts/generate-license-attributions.mjs",
    "prepare:nsis-loader-packs": "node scripts/prepare-nsis-loader-pack-hooks.mjs",
    "check:nsis-loader-packs": "node scripts/check-nsis-loader-pack-hooks.mjs",
    "check:nsis-loader-pack-bundle": "node scripts/check-nsis-loader-pack-bundle.mjs",
    "check:file-associations": "node scripts/check-file-associations.mjs",
    "check:file-associations:mac": "node scripts/check-file-associations.mjs src-tauri/target/release/bundle/macos/yw-look.app",
    "lint": "eslint .",
    "check:format-pack-boundaries": "node scripts/check-format-pack-boundaries.mjs",
    "check:viewer-viewport-boundaries": "node scripts/check-viewer-viewport-boundaries.mjs",
    "check:test-count": "node scripts/count-tests.mjs --check",
    "check:ipc-types": "cargo test --manifest-path src-tauri/Cargo.toml ipc_type_exports::generated_ipc_types_are_current",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview",
    "typecheck": "npm run typecheck:ts && npm run typecheck:rust",
    "typecheck:ts": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "typecheck:rust": "cargo check --manifest-path src-tauri/Cargo.toml",
    "check": "npm run lint && npm run format:check && npm run check:format-pack-boundaries && npm run check:viewer-viewport-boundaries && npm run check:test-count && npm run test && npm run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:count": "node scripts/count-tests.mjs",
    "test:batch": "node scripts/batch-load-test.mjs",
    "test:fixtures": "node scripts/fixture-regression.mjs",
    "test:fixtures:private": "node scripts/fixture-regression.mjs --catalog samples/private/catalog.json --private",
    "test:integration": "node scripts/run-selftest.mjs",
    "test:visual": "node scripts/visual-regression.mjs",
    "test:viewport-snapshot": "node scripts/viewport-snapshot.mjs",
    "test:viewport-snapshot:update": "node scripts/viewport-snapshot.mjs --update-snapshot",
    "test:viewport-state-snapshot": "node scripts/viewport-state-snapshot.mjs",
    "test:viewport-state-snapshot:update": "node scripts/viewport-state-snapshot.mjs --update-snapshot",
    "profile:sidebar-isolation": "node scripts/profile-sidebar-render-isolation.mjs",
    "local-assets:collect": "node scripts/collect-local-assets.mjs",
    "local-assets:check": "node scripts/local-asset-load-check.mjs",
    "local-assets:visual-review": "node scripts/local-asset-visual-review.mjs",
    "local-assets:visual-review:html": "node scripts/local-asset-visual-review.mjs --html-only",
    "local-assets:visual-review:serve": "node scripts/local-asset-visual-review.mjs --serve-only",
    "samples:fetch": "node samples/private/fetch.mjs",
    "bench:load": "node scripts/run-load-bench.mjs",
    "bench:load:baseline": "node scripts/compare-load-bench.mjs --write-baseline artifacts/bench/load-baseline.json",
    "bench:load:compare": "node scripts/compare-load-bench.mjs --baseline artifacts/bench/load-baseline.json",
    "bench:load:summary": "node scripts/summarize-load-bench.mjs",
    "bench:startup": "node scripts/run-startup-bench.mjs",
    "bench:startup:playwright": "node scripts/run-startup-bench.mjs --surface playwright",
    "bench:startup:packaged": "node scripts/run-startup-bench.mjs --surface packaged",
    "shot": "node scripts/run-shot.mjs shot",
    "shot:batch": "node scripts/run-shot.mjs shot-batch",
    "shot:check": "node scripts/run-shot.mjs check",
    "release:notes": "node scripts/extract-release-notes.mjs",
    "release:notes:check": "node scripts/extract-release-notes.mjs --check-contract",
    "release:preflight": "node scripts/run-release-preflight.mjs",
    "update:local:prepare": "node scripts/prepare-local-update-feed.mjs",
    "check:update-feed": "node scripts/check-local-update-feed.mjs",
    "check:release-updater": "node scripts/check-release-updater-manifest.mjs",
    "smoke:update-feed": "node scripts/smoke-local-update-feed.mjs",
    "check:win-authenticode": "node scripts/check-win-authenticode.mjs",
    "check:macos-codesign": "node scripts/check-macos-codesign.mjs",
    "update:local:serve": "node scripts/serve-local-update-feed.mjs",
    "tauri": "node scripts/run-tauri.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@pixiv/three-vrm": "^3.5.5",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-log": "^2.9.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-resizable-panels": "^4.12.3",
    "three": "^0.185.1",
    "three-mesh-bvh": "0.9.14",
    "zustand": "^5.0.15"
  },
  "optionalDependencies": {
    "@sparkjsdev/spark": "^2.1.0",
    "@yohawing/three-mmd-loader": "0.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/three": "^0.185.4",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^16.4.0",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md,html}": [
      "prettier --write"
    ]
  },
  "prettier": {
    "semi": true,
    "singleQuote": false,
    "trailingComma": "all"
  }
}
