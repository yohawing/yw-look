{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "yw-look",
  "version": "0.3.0",
  "identifier": "com.yohawing.ywlook",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "yw-look",
        "width": 1440,
        "height": 960,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": {
        "default-src": ["'self'"],
        "script-src": ["'self'", "'wasm-unsafe-eval'", "'unsafe-eval'"],
        "connect-src": [
          "'self'",
          "ipc:",
          "http://ipc.localhost",
          "http://localhost:*",
          "http://127.0.0.1:*",
          "blob:",
          "data:",
          "https:",
          "http:",
          "ws://localhost:*",
          "ws://127.0.0.1:*"
        ],
        "img-src": ["'self'", "asset:", "blob:", "data:", "https:", "http:"],
        "media-src": ["'self'", "asset:", "blob:", "data:", "https:", "http:"],
        "style-src": [
          "'self'",
          "'unsafe-inline'",
          "https://fonts.googleapis.com"
        ],
        "font-src": ["'self'", "https://fonts.gstatic.com", "data:"],
        "worker-src": ["'self'", "blob:"]
      }
    }
  },
  "plugins": {
    "updater": {
      "dangerousInsecureTransportProtocol": false,
      "endpoints": [],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJCQ0M2RDM1Qzc5RkE4REEKUldUYXFKL0hOVzNNSzNMbmRwUXpPazlRa3NZRzJtTVlKSVFvVHRDK05CellrYXZSRGJlTGR6elYK",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "macOS": {
      "entitlements": "Entitlements.plist"
    },
    "fileAssociations": [
      {
        "ext": [
          "glb",
          "gltf",
          "fbx",
          "obj",
          "ply",
          "stl",
          "dae",
          "usd",
          "usda",
          "usdc",
          "usdz",
          "abc"
        ],
        "name": "yw-look Model Asset",
        "description": "3D model asset opened by yw-look"
      },
      {
        "ext": [
          "png",
          "jpg",
          "jpeg",
          "tga",
          "dds",
          "psd",
          "ktx2",
          "hdr",
          "exr"
        ],
        "name": "yw-look Texture Asset",
        "description": "Texture asset opened by yw-look"
      },
      {
        "ext": ["bvh"],
        "name": "yw-look Motion Asset",
        "description": "Motion capture asset opened by yw-look"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
