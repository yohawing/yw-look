{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "yw-look",
  "version": "0.3.4",
  "identifier": "com.yohawing.ywlook",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "yw-look",
        "width": 1440,
        "height": 960,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": {
        "default-src": ["'self'"],
        "script-src": ["'self'", "'wasm-unsafe-eval'", "'unsafe-eval'"],
        "connect-src": [
          "'self'",
          "ipc:",
          "http://ipc.localhost",
          "http://localhost:*",
          "http://127.0.0.1:*",
          "blob:",
          "data:",
          "https:",
          "http:",
          "ws://localhost:*",
          "ws://127.0.0.1:*"
        ],
        "img-src": ["'self'", "asset:", "blob:", "data:", "https:", "http:"],
        "media-src": ["'self'", "asset:", "blob:", "data:", "https:", "http:"],
        "style-src": [
          "'self'",
          "'unsafe-inline'",
          "https://fonts.googleapis.com"
        ],
        "font-src": ["'self'", "https://fonts.gstatic.com", "data:"],
        "worker-src": ["'self'", "blob:"]
      }
    }
  },
  "plugins": {
    "updater": {
      "dangerousInsecureTransportProtocol": false,
      "endpoints": [],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJCQ0M2RDM1Qzc5RkE4REEKUldUYXFKL0hOVzNNSzNMbmRwUXpPazlRa3NZRzJtTVlKSVFvVHRDK05CellrYXZSRGJlTGR6elYK",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "macOS": {
      "entitlements": "Entitlements.plist"
    },
    "fileAssociations": [
      {
        "ext": ["glb"],
        "contentTypes": ["org.khronos.glb"],
        "name": "yw-look GLB Asset",
        "description": "GLB asset opened by yw-look",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": ["gltf"],
        "contentTypes": ["org.khronos.gltf"],
        "name": "yw-look glTF Asset",
        "description": "glTF asset opened by yw-look",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": ["fbx"],
        "contentTypes": ["com.autodesk.mac.fbx"],
        "name": "yw-look FBX Asset",
        "description": "FBX asset opened by yw-look",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": ["obj"],
        "contentTypes": ["public.geometry-definition-format"],
        "name": "yw-look OBJ Asset",
        "description": "OBJ asset opened by yw-look",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": ["ply"],
        "contentTypes": ["public.polygon-file-format"],
        "name": "yw-look PLY Asset",
        "description": "PLY asset opened by yw-look",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": ["3mf"],
