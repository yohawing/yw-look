        "name": "yw-look 3MF Asset",
        "description": "3MF asset opened by yw-look",
        "role": "Viewer",
        "rank": "Alternate",
        "exportedType": {
          "identifier": "com.yohawing.ywlook.3mf",
          "conformsTo": ["public.data"]
