#usda 1.0
(
    defaultPrim = "Root"
    upAxis = "Y"
    metersPerUnit = 1
)

def Xform "Root"
{
    def PointInstancer "Instancer"
    {
        # The prototypes relationship must point at prims UNDER the
        # PointInstancer prim (USD spec requirement for PointInstancer).
        rel prototypes = [
            </Root/Instancer/PrototypeCube>,
            </Root/Instancer/PrototypePyramid>
        ]

        # Six authored instances across two prototypes. id 103 is hidden,
        # leaving three cubes and two pyramids in the preview.
        int[] protoIndices = [0, 1, 0, 1, 0, 1]
        point3f[] positions = [(-3, 0, 0), (-1.8, 0, 0), (-0.6, 0, 0), (0.6, 0, 0), (1.8, 0, 0), (3, 0, 0)]
        quath[] orientations = [(1, 0, 0, 0), (0.92388, 0, 0.382683, 0), (1, 0, 0, 0), (1, 0, 0, 0), (1, 0, 0, 0), (0.92388, 0, -0.382683, 0)]
        float3[] scales = [(1, 1, 1), (0.8, 1.2, 0.8), (0.75, 0.75, 0.75), (1, 1, 1), (1.25, 1.25, 1.25), (1.1, 0.9, 1.1)]
        int64[] ids = [100, 101, 102, 103, 104, 105]
        int64[] invisibleIds = [103]

        def Mesh "PrototypeCube"
        {
            int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]
            int[] faceVertexIndices = [0, 1, 3, 2, 2, 3, 5, 4, 4, 5, 7, 6, 6, 7, 1, 0, 1, 7, 5, 3, 6, 0, 2, 4]
            point3f[] points = [
                (-0.5, -0.5,  0.5),
                ( 0.5, -0.5,  0.5),
                (-0.5,  0.5,  0.5),
                ( 0.5,  0.5,  0.5),
                (-0.5,  0.5, -0.5),
                ( 0.5,  0.5, -0.5),
                (-0.5, -0.5, -0.5),
                ( 0.5, -0.5, -0.5)
            ]
        }

        def Mesh "PrototypePyramid"
        {
            double3 xformOp:translate = (0, 0.25, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
            int[] faceVertexCounts = [4, 3, 3, 3, 3]
            int[] faceVertexIndices = [0, 1, 2, 3, 0, 4, 1, 1, 4, 2, 2, 4, 3, 3, 4, 0]
            point3f[] points = [
                (-0.5, -0.5,  0.5),
                ( 0.5, -0.5,  0.5),
                ( 0.5, -0.5, -0.5),
                (-0.5, -0.5, -0.5),
                ( 0.0,  0.6,  0.0)
            ]
        }
    }
}
