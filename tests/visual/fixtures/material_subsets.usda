#usda 1.0
(
    defaultPrim = "Root"
    upAxis = "Y"
    metersPerUnit = 1.0
    doc = "Self-authored regression fixture: two faces on one mesh use distinct GeomSubset material bindings."
)

def Xform "Root" (
    kind = "component"
)
{
    def Mesh "MaterialSubsetPanel" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        int[] faceVertexCounts = [4, 4]
        int[] faceVertexIndices = [0, 1, 2, 3, 4, 5, 6, 7]
        point3f[] points = [
            (-2, 0, -1), (0, 0, -1), (0, 0, 1), (-2, 0, 1),
            (0.1, 0, -1), (2, 0, -1), (2, 0, 1), (0.1, 0, 1)
        ]
        uniform token subdivisionScheme = "none"

        def GeomSubset "RedFace" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            uniform token elementType = "face"
            uniform token familyName = "materialBind"
            int[] indices = [0]
            rel material:binding = </Root/Looks/RedMat>
        }

        def GeomSubset "BlueFace" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            uniform token elementType = "face"
            uniform token familyName = "materialBind"
            int[] indices = [1]
            rel material:binding = </Root/Looks/BlueMat>
        }
    }

    def Scope "Looks"
    {
        def Material "RedMat"
        {
            token outputs:surface.connect = </Root/Looks/RedMat/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.85, 0.05, 0.03)
                float inputs:roughness = 0.35
                token outputs:surface
            }
        }

        def Material "BlueMat"
        {
            token outputs:surface.connect = </Root/Looks/BlueMat/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.03, 0.15, 0.9)
                float inputs:roughness = 0.65
                token outputs:surface
            }
        }
    }
}
