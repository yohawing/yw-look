#usda 1.0
(
    defaultPrim = "Root"
    upAxis = "Y"
)

def Xform "Root" (
    variants = {
        string look = "red"
    }
    prepend variantSets = ["look"]
)
{
    variantSet "look" = {
        "red" {
            def Mesh "RedQuad"
            {
                int[] faceVertexCounts = [4]
                int[] faceVertexIndices = [0, 1, 2, 3]
                point3f[] points = [(-1, 0, -1), (1, 0, -1), (1, 0, 1), (-1, 0, 1)]
                uniform token subdivisionScheme = "none"
            }
        }
        "blue" {
            def Mesh "BlueQuad"
            {
                int[] faceVertexCounts = [4]
                int[] faceVertexIndices = [0, 1, 2, 3]
                point3f[] points = [(-1, 0, -1), (1, 0, -1), (1, 0, 1), (-1, 0, 1)]
                uniform token subdivisionScheme = "none"
            }
        }
    }
}
