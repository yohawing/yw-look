#usda 1.0
(
    defaultPrim = "Root"
    upAxis = "Y"
)

def Xform "Root" (
    variants = {
        string look = "red"
    }
    prepend variantSets = ["look"]
)
{
    # This non-variant anchor keeps a stable framing reference while the
    # selected look changes both the mesh shape and its material.
    def Mesh "InlineAnchor" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [
            (-0.15, 0, 1.5), (0.15, 0, 1.5), (0.15, 0, 1.8), (-0.15, 0, 1.8)
        ]
        uniform token subdivisionScheme = "none"
        rel material:binding = </Root/Looks/AnchorMat>
    }

    variantSet "look" = {
        "red" {
            def Mesh "RedQuad" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                int[] faceVertexCounts = [4]
                int[] faceVertexIndices = [0, 1, 2, 3]
                point3f[] points = [
                    (-1.8, 0, -0.8), (-0.2, 0, -0.8), (-0.2, 0, 0.8), (-1.8, 0, 0.8)
                ]
                uniform token subdivisionScheme = "none"
                rel material:binding = </Root/Looks/RedMat>
            }
        }
        "blue" {
            def Mesh "BlueQuad" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                int[] faceVertexCounts = [4]
                int[] faceVertexIndices = [0, 1, 2, 3]
                point3f[] points = [
                    (0.3, 0, -1.2), (2.4, 0, -1.2), (2.1, 0, 1.2), (0.3, 0, 1.2)
                ]
                uniform token subdivisionScheme = "none"
                rel material:binding = </Root/Looks/BlueMat>
            }
        }
    }

    def Scope "Looks"
    {
        def Material "AnchorMat"
        {
            token outputs:surface.connect = </Root/Looks/AnchorMat/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.65, 0.65, 0.65)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "RedMat"
        {
            token outputs:surface.connect = </Root/Looks/RedMat/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.85, 0.05, 0.03)
                float inputs:roughness = 0.35
                token outputs:surface
            }
        }

        def Material "BlueMat"
        {
            token outputs:surface.connect = </Root/Looks/BlueMat/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.03, 0.15, 0.9)
                float inputs:roughness = 0.65
                token outputs:surface
            }
        }
    }
}
